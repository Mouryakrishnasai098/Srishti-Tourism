{
  "name": "srishti-tourism",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o www/tailwind.css --minify",
    "copy:libs": "mkdir -p www/vendor && cp node_modules/chart.js/dist/chart.umd.js www/vendor/chart.umd.js",
    "build": "npm run build:css && npm run copy:libs",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "chart.js": "4.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "tailwindcss": "3.4.17"
  }
}
